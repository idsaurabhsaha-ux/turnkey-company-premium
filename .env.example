# Use .dev.vars for local Worker development. Never commit actual credentials.
# Default when omitted: disabled. test never contacts any provider.
LEAD_MODE=test
ENABLE_TEST_MODE=true
# Production: live, disable test mode, and configure every applicable setting:
ALLOWED_ORIGINS=
LEAD_HASH_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=
PRIVACY_NOTICE_APPROVED=false
LEAD_PROVIDER=
INTERAKT_API_KEY=
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_ALLOWED_HOSTS=
LEAD_WEBHOOK_TOKEN=
LEAD_WEBHOOK_SIGNING_SECRET=
